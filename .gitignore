# Local .terraform directories
**/.terraform/*

# Keep override files as they are often used to include sensitive data
# that shouldn't be committed
!override.tf
!override.tf.json
!*_override.tf
!*_override.tf.json

# Include override files as they are often used to include sensitive data
# that shouldn't be committed
*.override.tf
*.override.tf.json
